<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/assets/css/style.css">
    <title>Document</title>
</head>

<body>
    <h1>URL Shortener</h1>
    <div class="main">
        <% if (locals.id) { %>
            <p>
                URL Generated: http://[::1]:3000/api/url/<%=id%>
            </p>
            <% } %>
                <form action="/url" method="post">

                    <label for="url">Enter your Original URL</label>
                    <input type="text" name="redirectURL" id="url" value="<%=locals.redirectUrl%>">
                    <input type="submit" value="Generate">
                </form>
                <% if (locals.urls) { %>
                    <table>
                        <thead>
                            <tr>
                                <th>Serial No</th>
                                <th>shortId</th>
                                <th>RedirectUrl</th>
                                <th>Clicks</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% let val=0; %>
                                <% if (locals.topUrl) { %>
                                    <% urls.forEach((url, index)=> { %>
                                        <% if ((String(topUrl.createdBy)===String(url.createdBy)) && locals.role
                                            !=='ADMIN' ) { %>
                                            <tr>
                                                <td>
                                                    <%= ++val %>
                                                </td>
                                                <td>
                                                    <%= url.shortId %>
                                                </td>
                                                <td>
                                                    <%= url.redirectUrl %>
                                                </td>
                                                <td>
                                                    <%= url.visitHistory.length + 1 %>
                                                </td>
                                            </tr>
                                            <% } %>
                                                <% }) %>
                                                    <% } %>
                                                        <% urls.forEach((url, index)=> { %>
                                                            <tr>
                                                                <td>
                                                                    <%= index+1 %>
                                                                </td>
                                                                <td>
                                                                    <%= url.shortId %>
                                                                </td>
                                                                <td>
                                                                    <%= url.redirectUrl %>
                                                                </td>
                                                                <td>
                                                                    <%= url.visitHistory.length + 1 %>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                               
                    </table>
                    <% } %>
    </div>
    
</body>

</html>