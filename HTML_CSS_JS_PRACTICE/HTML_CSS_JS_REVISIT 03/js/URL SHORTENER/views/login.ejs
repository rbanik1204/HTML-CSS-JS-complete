<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log in Form</title>
</head>

<body>
    <div class="main">
        <% if (locals.message) { %>
         <h1><%=message%></h1>
        <% } %>
        <form method="post" action="/users/login">
            <div>
                <label for="username">Username:&nbsp;</label>
                <input type="text" id="username" title="username" name="username" placeholder="Enter your username">
            </div>
            <div>
                <label for="password">Passoword:</label>
                <input type="password" id="password" title="password" name="password" placeholder="Enter your Password">
            </div>
            <div>
                <button type="submit">Submit</button>
            </div>
        </form>
        <% if (locals.url) { %>
         <a href="http://[::1]:3000/users/<%=locals.url%>">Sign Up now!</a>
        <% } %>
    </div>
</body>

</html>