<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log in Form</title>
</head>

<body>
    <div class="main">
         <% if (locals.message) { %>
         <h1><%=message%></h1>
        <% } %>
        <form method="post" action="/users/signup">
            <div>
                <label for="username">Username:</label>
                <input type="text" id="username" title="username" name="username" placeholder="Enter your username">
            </div>
            <div>
                <label for="email">Email:</label>
                <input type="email" name="email" title="email" placeholder="Enter your email">
            </div>
            <div>
                <label for="password">Password:</label>
                <input type="password" title="password" name="password" placeholder="Enter your Password">
            </div>
            <div>
                <button type="submit">Submit</button>
            </div>
        </form>
    </div>
</body>

</html>